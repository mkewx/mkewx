   5665  7e15		       85 1b		      sta	GRP0
   5666  7e17		       85 1c		      sta	GRP1
   5667  7e19		       85 1d		      sta	ENAM0
   5668  7e1b		       85 1e		      sta	ENAM1
   5669  7e1d		       85 1f		      sta	ENABL
   5670  7e1f		       85 ec		      sta	currentStage
   5671  7e21		       85 f0		      sta	scoreTens
   5672  7e23		       a9 20		      lda	#$20
   5673  7e25		       85 05		      sta	NUSIZ1
   5674  7e27		       a9 01		      lda	#1
   5675  7e29		       85 25		      sta	VDELP0
   5676  7e2b		       85 0a		      sta	CTRLPF
   5677  7e2d		       a9 0e		      lda	#SUIT_COLOR
