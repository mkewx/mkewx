   5751  7e00					      ORG	$7E00
   5752  7e00					      RORG	$FE00
   5753  7e00				   GameplayResume
   5754  7e00							; The terminal's third-fire jump to this gameplay entry (see
   5755  7e00							; TerminalToGameplayGate) fires from inside a jsr'd subroutine via a
   5756  7e00							; plain jmp, never executing its matching rts. That orphans the
   5757  7e00							; jsr's return address on the hardware stack. Left uncorrected, once
   5758  7e00							; gameplay's own call depth unwinds back to that stack level, an rts
   5759  7e00							; pops the stale address instead of its real caller, sending
   5760  7e00							; execution into unmapped memory until a stray zero byte reads as
   5761  7e00							; BRK and every bank's identical interrupt vector redirects back
   5762  7e00							; through Reset into credits -- reproducibly, regardless of input
   5763  7e00							; method or emulator. Reset the stack here, the same defensive reset
   5764  7e00							; Reset itself performs, so no stale entry survives into gameplay.
   5765  7e00		       a2 ff		      ldx	#$FF
   5766  7e02		       9a		      txs
   5767  7e03		       a9 00		      lda	#0
   5768  7e05		       85 19		      sta	AUDV0
   5769  7e07		       85 1a		      sta	AUDV1
   5770  7e09		       85 04		      sta	NUSIZ0
   5771  7e0b		       85 26		      sta	VDELP1
