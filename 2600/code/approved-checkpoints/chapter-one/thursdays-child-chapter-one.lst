   5638  7de7							; Restore the fixed gameplay TIA contract after the terminal bank.
   5639  7de7							; Stage data itself is initialized by Bank 0 on the first Frame call.
   5640  7e00					      ORG	$7E00
   5641  7e00					      RORG	$FE00
   5642  7e00				   GameplayResume
   5643  7e00							; The terminal's third-fire jump to this gameplay entry (see
   5644  7e00							; TerminalToGameplayGate) fires from inside a jsr'd subroutine via a
   5645  7e00							; plain jmp, never executing its matching rts. That orphans the
   5646  7e00							; jsr's return address on the hardware stack. Left uncorrected, once
   5647  7e00							; gameplay's own call depth unwinds back to that stack level, an rts
   5648  7e00							; pops the stale address instead of its real caller, sending
   5649  7e00							; execution into unmapped memory until a stray zero byte reads as
   5650  7e00							; BRK and every bank's identical interrupt vector redirects back
   5651  7e00							; through Reset into credits -- reproducibly, regardless of input
   5652  7e00							; method or emulator. Reset the stack here, the same defensive reset
   5653  7e00							; Reset itself performs, so no stale entry survives into gameplay.
   5654  7e00		       a2 ff		      ldx	#$FF
   5655  7e02		       9a		      txs
   5656  7e03		       a9 00		      lda	#0
   5657  7e05		       85 19		      sta	AUDV0
   5658  7e07		       85 1a		      sta	AUDV1
   5659  7e09		       85 04		      sta	NUSIZ0
