   5781  7e1f		       85 ec		      sta	currentStage
   5782  7e21		       85 f0		      sta	scoreTens
   5783  7e23		       a9 20		      lda	#$20
   5784  7e25		       85 05		      sta	NUSIZ1
   5785  7e27		       a9 01		      lda	#1
   5786  7e29		       85 25		      sta	VDELP0
   5787  7e2b		       85 0a		      sta	CTRLPF
   5788  7e2d		       a9 0e		      lda	#SUIT_COLOR
