    409  1293
    410  1293							; A - E - D - Bm - Em - F#m - G - B. Coarse TIA tuning makes a few thirds
    411  1293							; approximate, so the voicings emphasize clean roots and fifths while still
    412  1293							; distinguishing the minor chords. All lead dividers stay between 10 and 25.
    413  1293				   TitleArpeggio
    414  1293		       17 12 0f 0b*	      byte.b	23,18,15,11,15,18,15,18	; A
    415  129b		       0f 0a 0f 0a*	      byte.b	15,10,15,10,12,10,15,10	; E
    416  12a3		       11 0d 0b 0d*	      byte.b	17,13,11,13,17,13,11,13	; D
    417  12ab		       14 11 0d 0a*	      byte.b	20,17,13,10,13,17,13,17	; Bm
    418  12b3		       0f 0c 0a 0c*	      byte.b	15,12,10,12,15,12,10,12	; Em
    419  12bb		       0d 0b 12 0b*	      byte.b	13,11,18,11,13,11,18,11	; F#m
    420  12c3		       19 14 11 0c*	      byte.b	25,20,17,12,17,20,17,20	; G
    421  12cb		       14 10 0d 0a*	      byte.b	20,16,13,10,13,16,13,16	; B
    422  12d3
    423  12d3							; One safe low-register support per chord. E and D use their fifths because
    424  12d3							; their roots would fall beyond the clean divider range in this bass timbre.
    425  12d3				   TitleBassNotes
    426  12d3		       17 15 17 15*	      byte.b	23,21,23,21,21,27,25,21
    427  12db
