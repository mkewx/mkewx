    109  8000 ????
    110  8000 ????						; Production scoring is stored in units of ten points. Three required Space
    111  8000 ????						; Junk pieces and one optional Space Relic make a perfect zone worth 220:
    112  8000 ????						; 3 * 40 + 100. Across all 42 planned zones the mathematical maximum is 9240.
    113  8000 ????						; The arithmetic nevertheless saturates at 9990 so corruption can never wrap.
    114  8000 ????	       00 04	   SCORE_JUNK_TENS =	4
    115  8000 ????	       00 0a	   SCORE_RELIC_TENS =	10
    116  8000 ????	       00 03	   SCORE_MAX_TENS_HI =	$03	; 999 decimal = $03E7 ten-point units
    117  8000 ????	       00 e7	   SCORE_MAX_TENS_LO =	$E7
    118  8000 ????
    119  8000 ????						; One-channel production sound vocabulary. Music remains deliberately absent
    120  8000 ????						; in 0.8A so each gameplay event can be judged without masking or contention.
    121  8000 ????	       00 00	   SFX_NONE   =	0
    122  8000 ????	       00 01	   SFX_CAPTURE =	1
    123  8000 ????	       00 02	   SFX_RELEASE =	2
    124  8000 ????	       00 03	   SFX_REQUIRED =	3
    125  8000 ????	       00 04	   SFX_OPTIONAL =	4
    126  8000 ????	       00 05	   SFX_EXIT_READY =	5
    127  8000 ????	       00 06	   SFX_STAGE_COMPLETE =	6
    128  8000 ????	       00 ff	   MUSIC_REST =	$FF
    129  8000 ????
    130  8000 ????						; Production stage vocabulary. The engine uses structure-of-arrays descriptors
    131  8000 ????						; because indexed byte loads are cheaper than multiplying a stage record size.
    132  8000 ????	       00 05	   STAGE_COUNT =	5
    133  8000 ????	       00 ff	   NO_NEXT_STAGE =	$FF
    134  8000 ????	       00 00	   TERRAIN_AMETHYST =	0
    135  8000 ????	       00 01	   TERRAIN_COBALT =	1
    136  8000 ????	       00 02	   TERRAIN_EMERALD =	2
